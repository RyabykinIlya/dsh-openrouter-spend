{
  "name": "dsh-openrouter-spend",
  "version": "0.4.0",
  "description": "DeepSeek Harness plugin: shows what the OpenRouter account actually charged today — per chat and in total, under the composer and in Settings, split by model and API key.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "openrouter",
    "spend",
    "cost",
    "analytics"
  ],
  "license": "MIT",
  "author": "Ilya Ryabykin",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyabykinIlya/dsh-openrouter-spend.git"
  },
  "homepage": "https://github.com/RyabykinIlya/dsh-openrouter-spend#readme",
  "bugs": {
    "url": "https://github.com/RyabykinIlya/dsh-openrouter-spend/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "verify-translation": "node scripts/verify-translation-sync.mjs",
    "postinstall": "lefthook install || true"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "lefthook": "^1.13.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
